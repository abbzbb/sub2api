[Unit]
Description=Sub2API WARP Gateway (Cloudflare WARP SOCKS control plane)
After=network.target
Documentation=https://github.com/Wei-Shaw/sub2api

[Service]
Type=simple
User=warp-gateway
Group=warp-gateway
WorkingDirectory=/opt/warp-gateway
ExecStart=/opt/warp-gateway/warp-gateway -listen 127.0.0.1:19798 -data-dir /var/lib/warp-gateway -runtime sing-box
Restart=always
RestartSec=3
# For sing-box/WireGuard runtime, grant CAP_NET_ADMIN on a dedicated unit instead of sub2api.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/warp-gateway
Environment=WARP_GATEWAY_TOKEN=
Environment=WARP_GATEWAY_RUNTIME=sing-box
# Re-register one duplicate-exit-IP instance per health tick (cooldown 15m).
# Set false to keep alerting without rotating.
Environment=WARP_GATEWAY_AUTO_ROTATE_DUPLICATE_EXIT_IP=true
Environment=WARP_GATEWAY_AUTO_ROTATE_COOLDOWN=15m

[Install]
WantedBy=multi-user.target
